<Application x:Class="AudioMapTool.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:AudioMapTool.Converters"
             StartupUri="MainWindow.xaml">
    <Application.Resources>

        <!-- 字串是否為空的轉換器:「開場片段」「循環片段」「最大音量」頁簽的 DataGridRow.IsEnabled 用它判斷該列是否要反灰 -->
        <converters:NullOrEmptyToBooleanConverter x:Key="NullOrEmptyToBooleanConverter" />

        <!-- 音量欄位字串 <-> 0~1 的轉換器:「最大音量」頁簽的音量欄用 Slider 拖曳調整,底層還是存字串 -->
        <converters:VolumeStringConverter x:Key="VolumeStringConverter" />

        <!--
            DataGrid 儲存格:去掉「目前儲存格」的焦點框,只靠選取儲存格的反藍顯示;
            選取時改成淡藍色(不覆寫系統的 SystemColors.ControlBrushKey/HighlightBrushKey,
            那兩個資源被 DataGrid 空白區域等其他地方共用,改了會連沒有資料的空白區域都變色)
        -->
        <Style x:Key="DataGridCellStyleNoBorder" TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#CCE8FF" />
                    <Setter Property="Foreground" Value="Black" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!--
            DataGrid 儲存格內的可編輯 TextBox 共用外觀:白底、無邊框、內容垂直置中。
            TextBox 本身不透明,會蓋住 DataGridCell 的背景,所以選取時要另外把 TextBox 自己的
            背景也改成跟 DataGridCellStyleNoBorder 同一色的淡藍色,兩者才會一致。
        -->
        <Style x:Key="DataGridCellTextBoxStyle" TargetType="TextBox">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="White" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="2,0,2,0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=DataGridCell}, Path=IsSelected}" Value="True">
                    <Setter Property="Background" Value="#CCE8FF" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!--
            DataGridCheckBoxColumn 用的 CheckBox 置中顯示。
            IsEnabled 綁到 AudioMapRow.IsEditableWhenIdle:這一列播放中或暫停中時,「選」欄要鎖定,
            四個頁簽的「選」欄都用這個共用樣式,所以在這裡綁一次就對全部頁簽生效。
        -->
        <Style x:Key="DataGridCellCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="IsEnabled" Value="{Binding IsEditableWhenIdle}" />
        </Style>

        <!--
            頁簽按鈕外觀(未指定 x:Key,套用到整個應用程式所有的 TabItem)。
            目前只設定最小寬度,之後要調整頁簽外觀(顏色、Padding...等)可以直接在這裡加 Setter。
        -->
        <Style TargetType="TabItem">
            <Setter Property="Padding" Value="20 0" />
        </Style>

    </Application.Resources>
</Application>
