<Window x:Class="AudioMapTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fragment="clr-namespace:AudioMapTool.Fragment"
        Title="音效檔對照表" Height="600" Width="800"
        WindowStartupLocation="CenterScreen"
        KeyDown="Window_KeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- 第0列:選單 -->
            <RowDefinition Height="Auto" /> <!-- 第1列:工具列按鈕 -->
            <RowDefinition Height="*" />    <!-- 第2列:頁簽(對照表) -->
            <RowDefinition Height="Auto" /> <!-- 第3列:播放進度條 -->
        </Grid.RowDefinitions>

        <!--
            選單:檔案(新增/開啟/存檔/另存新檔/關閉)、編輯(復原/取消復原),Click 統一走 MainWindow.xaml.cs 的 MenuItem_Click。
            播放中/暫停中(見「最大音量」頁簽)這裡會整個 IsEnabled=False,連 Ctrl+S/Z/Y 快捷鍵也一併擋掉,
            避免播放中新增/刪除/開檔/復原把正在播放的那筆資料換掉。
        -->
        <Menu x:Name="mainMenu" Grid.Row="0">
            <MenuItem Header="檔案(_F)">
                <MenuItem x:Name="miNew" Header="新增(_N)" Click="MenuItem_Click" />
                <MenuItem x:Name="miOpen" Header="開啟(_O)..." Click="MenuItem_Click" />
                <MenuItem x:Name="miSave" Header="存檔(_S)" Click="MenuItem_Click" />
                <MenuItem x:Name="miSaveAs" Header="另存新檔(_A)..." Click="MenuItem_Click" />
                <Separator />
                <MenuItem x:Name="miClose" Header="關閉(_C)" Click="MenuItem_Click" />
            </MenuItem>
            <MenuItem Header="編輯(_E)">
                <MenuItem x:Name="miUndo" Header="復原(_U)" InputGestureText="Ctrl+Z" Click="MenuItem_Click" IsEnabled="False" />
                <MenuItem x:Name="miRedo" Header="取消復原(_R)" InputGestureText="Ctrl+Y" Click="MenuItem_Click" IsEnabled="False" />
            </MenuItem>
        </Menu>

        <!--
            工具列:全選/反選/新增/刪除/拷貝,Click 統一走 MainWindow.xaml.cs 的 BtnToolbar_Click;
            後面的「資料夾」是音效檔的基準資料夾——「路徑」頁簽的「音效檔名稱」欄只存檔名,
            實際檔案位置 = 這個資料夾 + 檔名,選好資料夾之後「音效檔名稱」欄才能用(見 PathMapControl.FolderPath)。
            整排在播放中/暫停中會 IsEnabled=False(見 MainWindow.xaml.cs 的 SetGlobalControlsEnabled)。
        -->
        <StackPanel x:Name="toolbarPanel" Grid.Row="1" Orientation="Horizontal" Margin="4">
            <Button x:Name="btnSelectAll" Content="全選" Padding="8,2" Margin="0,0,4,0" Click="BtnToolbar_Click" />
            <Button x:Name="btnInvertSelect" Content="反選" Padding="8,2" Margin="0,0,4,0" Click="BtnToolbar_Click" />
            <Button x:Name="btnAdd" Content="新增" Padding="8,2" Margin="0,0,4,0" Click="BtnToolbar_Click" />
            <Button x:Name="btnDelete" Content="刪除" Padding="8,2" Margin="0,0,4,0" Click="BtnToolbar_Click" />
            <Button x:Name="btnCopy" Content="拷貝" Padding="8,2" Margin="0,0,4,0" Click="BtnToolbar_Click" />

            <TextBlock Text="資料夾" VerticalAlignment="Center" Margin="16,0,4,0" />
            <Grid Width="220" Height="22" VerticalAlignment="Center">
                <TextBox x:Name="txtFolder" IsReadOnly="True" VerticalContentAlignment="Center" Padding="4,0,26,0" />
                <Button Content="..."
                        Width="22" Height="20"
                        Padding="0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,1,0"
                        Click="BtnBrowseFolder_Click" />
            </Grid>
        </StackPanel>

        <!--
            頁簽:每個頁簽都是自己專屬的 UserControl(Fragment 資料夾底下),欄位結構各自不同,
            但四個頁簽共用同一份 AudioMapRow 資料(MainWindow 建立視窗時把同一個 ObservableCollection
            指定給四個控制項的 Items),同一列在四個頁簽對應到同一筆資料。
            SelectionChanged 統一走 MainWindow.xaml.cs 的 TabMain_SelectionChanged:切頁簽時把「目前作用列」
            「最後捲動位置」套用到剛顯示出來的頁簽,讓切頁簽時停在使用者原本看的同一列/同一個捲動位置。
        -->
        <TabControl x:Name="tabMain" Grid.Row="2" Margin="4" SelectionChanged="TabMain_SelectionChanged">
            <TabItem Header="路徑">
                <fragment:PathMapControl x:Name="pathMapControl" />
            </TabItem>
            <TabItem Header="開場片段">
                <fragment:OpeningSegmentControl x:Name="openingSegmentControl" />
            </TabItem>
            <TabItem Header="循環片段">
                <fragment:LoopSegmentControl x:Name="loopSegmentControl" />
            </TabItem>
            <TabItem Header="最大音量">
                <fragment:MaxVolumeControl x:Name="maxVolumeControl" />
            </TabItem>
        </TabControl>

        <!--
            播放進度條(最下方):上面對應「開場片段」總時長,下面對應「循環片段」總時長,
            用來在暫停中精準抓取時間點。播放中兩條都反灰(隨播放自動移動,不能拖);
            暫停中「開場片段」進度條隨時能拖,「循環片段」進度條只有已經進入循環片段(開場片段條滿了)才能拖。
            沒有任何列在播放/暫停時,兩條都反灰並歸零。ValueChanged 統一走 MainWindow.xaml.cs 的
            SliderOpeningPosition_ValueChanged/SliderLoopPosition_ValueChanged。
            右側兩個時間文字點一下會把目前顯示的時間複製到剪貼簿(方便貼到開場/循環片段的時間欄位),
            統一走 MainWindow.xaml.cs 的 TxtPosition_Click。
        -->
        <Grid Grid.Row="3" Margin="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="開場片段" VerticalAlignment="Center" Margin="0,0,8,0" />
            <Slider x:Name="sliderOpeningPosition" Grid.Row="0" Grid.Column="1"
                    Minimum="0" Maximum="1" IsEnabled="False" VerticalAlignment="Center"
                    ValueChanged="SliderOpeningPosition_ValueChanged" />
            <TextBlock x:Name="txtOpeningPosition" Grid.Row="0" Grid.Column="2"
                       Width="110" VerticalAlignment="Center" Margin="8,0,0,0" Text="00:00:00:0000"
                       Cursor="Hand" ToolTip="點一下複製這個時間" MouseLeftButtonUp="TxtPosition_Click" />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="循環片段" VerticalAlignment="Center" Margin="0,4,8,0" />
            <Slider x:Name="sliderLoopPosition" Grid.Row="1" Grid.Column="1"
                    Minimum="0" Maximum="1" IsEnabled="False" VerticalAlignment="Center" Margin="0,4,0,0"
                    ValueChanged="SliderLoopPosition_ValueChanged" />
            <TextBlock x:Name="txtLoopPosition" Grid.Row="1" Grid.Column="2"
                       Width="110" VerticalAlignment="Center" Margin="8,4,0,0" Text="00:00:00:0000"
                       Cursor="Hand" ToolTip="點一下複製這個時間" MouseLeftButtonUp="TxtPosition_Click" />
        </Grid>
    </Grid>
</Window>
