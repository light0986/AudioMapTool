<Window x:Class="AudioMapTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="音效檔對照表" Height="600" Width="800"
        WindowStartupLocation="CenterScreen"
        KeyDown="Window_KeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- 第0列:選單 -->
            <RowDefinition Height="Auto" /> <!-- 第1列:工具列按鈕 -->
            <RowDefinition Height="*" />    <!-- 第2列:對照表 DataGrid -->
        </Grid.RowDefinitions>

        <!-- 選單:檔案(新增/開啟/存檔/另存新檔/關閉)、編輯(復原/取消復原),Click 統一走 MainWindow.xaml.cs 的 MenuItem_Click -->
        <Menu Grid.Row="0">
            <MenuItem Header="檔案(_F)">
                <MenuItem x:Name="miNew" Header="新增(_N)" Click="MenuItem_Click" />
                <MenuItem x:Name="miOpen" Header="開啟(_O)..." Click="MenuItem_Click" />
                <MenuItem x:Name="miSave" Header="存檔(_S)" Click="MenuItem_Click" />
                <MenuItem x:Name="miSaveAs" Header="另存新檔(_A)..." Click="MenuItem_Click" />
                <Separator />
                <MenuItem x:Name="miClose" Header="關閉(_C)" Click="MenuItem_Click" />
            </MenuItem>
            <MenuItem Header="編輯(_E)">
                <MenuItem x:Name="miUndo" Header="復原(_U)" InputGestureText="Ctrl+Z" Click="MenuItem_Click" IsEnabled="False" />
                <MenuItem x:Name="miRedo" Header="取消復原(_R)" InputGestureText="Ctrl+Y" Click="MenuItem_Click" IsEnabled="False" />
            </MenuItem>
        </Menu>

        <!-- 工具列:全選/反選/新增/刪除/拷貝,Click 統一走 MainWindow.xaml.cs 的 BtnToolbar_Click -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="4">
            <Button x:Name="btnSelectAll" Content="全選" Padding="8,2" Margin="0,0,4,0" Click="BtnToolbar_Click" />
            <Button x:Name="btnInvertSelect" Content="反選" Padding="8,2" Margin="0,0,4,0" Click="BtnToolbar_Click" />
            <Button x:Name="btnAdd" Content="新增" Padding="8,2" Margin="0,0,4,0" Click="BtnToolbar_Click" />
            <Button x:Name="btnDelete" Content="刪除" Padding="8,2" Margin="0,0,4,0" Click="BtnToolbar_Click" />
            <Button x:Name="btnCopy" Content="拷貝" Padding="8,2" Margin="0,0,4,0" Click="BtnToolbar_Click" />
        </StackPanel>

        <!--
            對照表主體:
            - SelectionUnit="Cell":反藍只反單一儲存格,不是整列
            - RowHeight="24" + CellStyle(DataGridCellStyleNoBorder,定義在 App.xaml):固定列高、去掉目前儲存格的焦點框,
              避免顯示/編輯模式切換時列高跳動、兩欄外觀不一致
        -->
        <DataGrid x:Name="dgAudioMap" Grid.Row="2"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="True"
                  RowHeight="24"
                  SelectionUnit="Cell"
                  CellStyle="{StaticResource DataGridCellStyleNoBorder}"
                  Margin="4">
            <DataGrid.Columns>

                <!-- 選:批次操作(刪除/拷貝)用的勾選欄,置中顯示 -->
                <DataGridCheckBoxColumn Header="選" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="40"
                                         ElementStyle="{StaticResource DataGridCellCheckBoxStyle}"
                                         EditingElementStyle="{StaticResource DataGridCellCheckBoxStyle}" />

                <!--
                    功能代號:永遠可編輯的 TextBox(不需要雙擊進入編輯模式)。
                    GotFocus 記錄目前作用列;LostFocus 驗證代號是否跟其他列重複。
                -->
                <DataGridTemplateColumn x:Name="colCode" Header="功能代號" Width="200">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBox x:Name="txtCode"
                                     Style="{StaticResource DataGridCellTextBoxStyle}"
                                     Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}"
                                     GotFocus="TxtCode_GotFocus"
                                     LostFocus="TxtCode_LostFocus"
                                     KeyDown="TxtRow_KeyDown" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!--
                    音效檔路徑:TextBox 疊加一個右側查詢按鈕("...")。
                    按鈕平常顯示,方便直接點擊跳出 OpenFileDialog 選檔;
                    一旦游標點進 TextBox(IsKeyboardFocusWithin=True)取得焦點準備手動輸入時,
                    按鈕就會收合隱藏,避免擋住輸入區域。
                    Padding 右側留 26px 空間,剛好讓文字不會被按鈕蓋住。
                -->
                <DataGridTemplateColumn Header="音效檔路徑" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid>
                                <TextBox x:Name="txtFilePath"
                                         Style="{StaticResource DataGridCellTextBoxStyle}"
                                         Text="{Binding FilePath, UpdateSourceTrigger=PropertyChanged}"
                                         GotFocus="TxtFilePath_GotFocus"
                                         LostFocus="TxtFilePath_LostFocus"
                                         KeyDown="TxtRow_KeyDown"
                                         Padding="2,0,26,0" />
                                <Button Content="..."
                                        Width="22" Height="20"
                                        Padding="0"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Margin="0,0,2,0"
                                        Click="BtnBrowseAudio_Click">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <!-- txtFilePath 取得鍵盤焦點時,隱藏查詢按鈕 -->
                                                <DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=txtFilePath}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
