<UserControl x:Class="AudioMapTool.Fragment.MaxVolumeControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <!--
            對照表主體(「最大音量」頁簽):選/功能代號/音量/開始/停止/暫停,綁定共用 AudioMapRow 的 MaxS。
            RowStyle:音效檔名稱空白,或被別列的播放鎖定時,整列反灰不能使用(見 IsMaxVolumeTabRowEnabled)。
            注意這裡「不」看自己的 PlaybackState——播放/暫停中還是要留著「暫停」「停止」按鈕能點,
            音量滑桿也要能繼續拖(即時調整播放中的音量),所以只有選/功能代號改成個別綁 IsEditableWhenIdle,
            三個按鈕各自綁 CanPlay/CanPause/CanStop
            (見 MaxVolumeControl.xaml.cs 的 BtnStart_Click/BtnPause_Click/BtnStop_Click,
            實際播放邏輯在 Services/PlaybackController.cs)。
        -->
        <DataGrid x:Name="dgMaxVolume"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="True"
                  RowHeight="24"
                  SelectionUnit="Cell"
                  CellStyle="{StaticResource DataGridCellStyleNoBorder}"
                  Margin="4">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="IsEnabled" Value="{Binding IsMaxVolumeTabRowEnabled}" />
                    <Style.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>

                <!-- 選:批次操作(刪除/拷貝)用的勾選欄,置中顯示 -->
                <DataGridCheckBoxColumn Header="選" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="40"
                                         ElementStyle="{StaticResource DataGridCellCheckBoxStyle}"
                                         EditingElementStyle="{StaticResource DataGridCellCheckBoxStyle}" />

                <!-- 功能代號:永遠可編輯的 TextBox。GotFocus 記錄目前作用列;LostFocus 驗證代號是否跟其他列重複。 -->
                <DataGridTemplateColumn x:Name="colCode" Header="功能代號" Width="200">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBox x:Name="txtCode"
                                     Style="{StaticResource DataGridCellTextBoxStyle}"
                                     Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding IsEditableWhenIdle}"
                                     GotFocus="TxtCode_GotFocus"
                                     LostFocus="TxtCode_LostFocus"
                                     KeyDown="TxtRow_KeyDown" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!--
                    音量:範圍固定 0~1,改用 Slider 拖曳調整(不能直接打字輸入),右側顯示目前數值。
                    MaxS 本身還是字串(跟其他欄位一致,方便存 ini),透過 VolumeStringConverter 跟 Slider.Value(double)互轉。
                    GotFocus/LostFocus 記錄復原快照的邏輯跟其他欄位一致:只在放開滑桿、真的有異動時才推進復原堆疊,
                    不會每拖一下就記一筆。刻意不綁 IsEditableWhenIdle——播放中/暫停中都要能拖,
                    PlaybackController 訂閱了這一列的 MaxS 變化,拖動當下就會即時套用到正在播放的音量。
                -->
                <DataGridTemplateColumn Header="音量" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="44" />
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="sliderVolume"
                                        Grid.Column="0"
                                        Minimum="0" Maximum="1"
                                        SmallChange="0.01" LargeChange="0.1"
                                        VerticalAlignment="Center"
                                        Value="{Binding MaxS, Converter={StaticResource VolumeStringConverter}, UpdateSourceTrigger=PropertyChanged}"
                                        GotFocus="SliderVolume_GotFocus"
                                        LostFocus="SliderVolume_LostFocus" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Value, ElementName=sliderVolume, StringFormat={}{0:0.00}}"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Right"
                                           Margin="4,0,2,0" />
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- 開始:未播放、或暫停中(接續播放)可點;播放中、或被別列鎖定時不可點。 -->
                <DataGridTemplateColumn Header="開始" Width="70">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="開始" Padding="4,0" IsEnabled="{Binding CanPlay}" Click="BtnStart_Click" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                
                <!-- 暫停:只有播放中可點。 -->
                <DataGridTemplateColumn Header="暫停" Width="70">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="暫停" Padding="4,0" IsEnabled="{Binding CanPause}" Click="BtnPause_Click" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                
                <!-- 停止:播放中或暫停中可點;完全沒播放、或被別列鎖定時不可點。 -->
                <DataGridTemplateColumn Header="停止" Width="70">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="停止" Padding="4,0" IsEnabled="{Binding CanStop}" Click="BtnStop_Click" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
